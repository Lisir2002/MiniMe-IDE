<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：normal 级，安装即授；本地预览不上传任何用户数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 存储：日志写入外部根目录 MINIIDE（API≤28 用 WRITE_EXTERNAL_STORAGE；API≥30 用 MANAGE_EXTERNAL_STORAGE） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 定位/相机：当前版本无对应功能，仅预留声明，不主动申请 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 打开外部应用（Android 11+ 包可见性）与安装未知应用（special，跳设置页） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MiniMeApp"
        android:allowBackup="true"
        android:label="MiniMe-IDE"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniMeIDE">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="MiniMe-IDE"
            android:theme="@style/Theme.MiniMeIDE">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
